diff --git a/src/Emulator/Peripherals/Peripherals/Miscellaneous/NXP_IMX8MP_DDRC.cs b/src/Emulator/Peripherals/Peripherals/Miscellaneous/NXP_IMX8MP_DDRC.cs
new file mode 100644
index 000000000..8ea4a0ad5
--- /dev/null
+++ b/src/Emulator/Peripherals/Peripherals/Miscellaneous/NXP_IMX8MP_DDRC.cs
@@ -0,0 +1,86 @@
+//
+// Copyright (c) 2010-2026 Antmicro
+//
+// This file is licensed under the MIT License.
+// Full license text is available in 'licenses/MIT.txt'.
+//
+using System.Collections.Generic;
+
+using Antmicro.Renode.Core;
+using Antmicro.Renode.Peripherals.Bus;
+
+namespace Antmicro.Renode.Peripherals.Miscellaneous
+{
+    // i.MX 8M DDR controller (Synopsys uMCTL2) register file with the status handshakes TF-A's DDR DVFS
+    // (ddr4_swffc/sw_pstate, used for Linux busfreq requests) waits for. There is no DRAM timing behind it:
+    // registers store what is written, and status registers follow their control bits immediately.
+    public class NXP_IMX8MP_DDRC : IDoubleWordPeripheral, IKnownSize
+    {
+        public NXP_IMX8MP_DDRC(IMachine machine)
+        {
+            Reset();
+        }
+
+        public void Reset()
+        {
+            registers.Clear();
+        }
+
+        public uint ReadDoubleWord(long offset)
+        {
+            switch((Registers)offset)
+            {
+            case Registers.Status:
+                // operating_mode: self-refresh (SW-initiated, 0x23) while PWRCTL.selfref_sw is set, normal otherwise
+                return (Get(Registers.PowerControl) & SelfRefreshSoftware) != 0 ? StatusSelfRefresh : StatusNormal;
+            case Registers.ModeRegisterStatus:
+                return 0; // mr_wr_busy never set
+            case Registers.DfiStatus:
+                // dfi_init_complete drops while DFIMISC.dfi_init_start is asserted
+                return (Get(Registers.DfiMisc) & DfiInitStart) != 0 ? 0u : 1u;
+            case Registers.DebugCam:
+                return DebugCamEmpty;
+            case Registers.SoftwareStatus:
+                return Get(Registers.SoftwareControl) & SoftwareDone;
+            case Registers.PortStatus:
+                return 0; // no outstanding port transactions
+            default:
+                return Get((Registers)offset);
+            }
+        }
+
+        public void WriteDoubleWord(long offset, uint value)
+        {
+            registers[offset] = value;
+        }
+
+        public long Size => 0x10000;
+
+        private uint Get(Registers register)
+        {
+            return registers.TryGetValue((long)register, out var value) ? value : 0;
+        }
+
+        private readonly Dictionary<long, uint> registers = new Dictionary<long, uint>();
+
+        private const uint SelfRefreshSoftware = 1u << 5;
+        private const uint StatusSelfRefresh = 0x23;
+        private const uint StatusNormal = 0x1;
+        private const uint DfiInitStart = 1u << 5;
+        private const uint DebugCamEmpty = 0x36000000; // wr/rd queues and data pipelines empty
+        private const uint SoftwareDone = 0x1;
+
+        private enum Registers : long
+        {
+            Status = 0x04,
+            ModeRegisterStatus = 0x18,
+            PowerControl = 0x30,
+            DfiMisc = 0x1B0,
+            DfiStatus = 0x1BC,
+            DebugCam = 0x308,
+            SoftwareControl = 0x320,
+            SoftwareStatus = 0x324,
+            PortStatus = 0x3FC,
+        }
+    }
+}
diff --git a/src/Emulator/Peripherals/Peripherals/Miscellaneous/NXP_IMX8MP_GPC.cs b/src/Emulator/Peripherals/Peripherals/Miscellaneous/NXP_IMX8MP_GPC.cs
new file mode 100644
index 000000000..f6f7cf4a0
--- /dev/null
+++ b/src/Emulator/Peripherals/Peripherals/Miscellaneous/NXP_IMX8MP_GPC.cs
@@ -0,0 +1,200 @@
+//
+// Copyright (c) 2010-2026 Antmicro
+//
+// This file is licensed under the MIT License.
+// Full license text is available in 'licenses/MIT.txt'.
+//
+using Antmicro.Renode.Core;
+using Antmicro.Renode.Exceptions;
+using Antmicro.Renode.Logging;
+using Antmicro.Renode.Peripherals.Bus;
+using Antmicro.Renode.Peripherals.CPU;
+using Antmicro.Renode.Peripherals.IRQControllers;
+
+namespace Antmicro.Renode.Peripherals.Miscellaneous
+{
+    // i.MX 8M Plus General Power Controller: models A53 core power-down on WFI and wake-up on interrupt,
+    // which TF-A uses for PSCI CPU_SUSPEND (Linux cpuidle "cpu-pd-wait").
+    //
+    // TF-A arms a core with LPCR_A53_AD.COREx_WFI_PDN/COREx_IRQ_WUP and COREx_PGC_PCR, disables the core's
+    // GIC CPU interface (GICR_WAKER.ProcessorSleep) and parks it in a `wfi` loop. On hardware the GPC then
+    // powers the core down, and when the redistributor raises its wake request it powers the core up,
+    // which restarts it from the reset vector programmed in the SRC (TF-A's warm boot entry).
+    //
+    // All other registers keep the behaviour of the former `flipflop.py` stub: every access toggles a
+    // shared state and reads return 0 or 0xFFFFFFFF, so software polling status/trigger bits terminates.
+    public class NXP_IMX8MP_GPC : IDoubleWordPeripheral, IKnownSize
+    {
+        public NXP_IMX8MP_GPC(IMachine machine, ARM_GenericInterruptController gic, NXP_IMX8MP_SystemResetController src, TranslationCPU[] cpus)
+        {
+            if(cpus.Length != NumCores)
+            {
+                throw new ConstructionException($"Expected exactly {NumCores} CPUs, got {cpus.Length}");
+            }
+            this.machine = machine;
+            this.gic = gic;
+            this.src = src;
+            this.cpus = cpus;
+            pgcPcr = new uint[NumCores];
+            poweredDown = new bool[NumCores];
+
+            for(var i = 0; i < NumCores; i++)
+            {
+                var core = i;
+                cpus[i].AddHookAtWfiStateChange(isInWfi => OnWfiStateChange(core, isInWfi));
+            }
+            gic.WakeRequest += OnWakeRequest;
+            Reset();
+        }
+
+        public void Reset()
+        {
+            lock(locker)
+            {
+                flipFlop = false;
+                lpcrA53Ad = 0;
+                for(var i = 0; i < NumCores; i++)
+                {
+                    pgcPcr[i] = 0;
+                    poweredDown[i] = false;
+                }
+            }
+        }
+
+        public uint ReadDoubleWord(long offset)
+        {
+            lock(locker)
+            {
+                if(offset == LpcrA53AdOffset)
+                {
+                    return lpcrA53Ad;
+                }
+                if(TryGetCorePgcPcr(offset, out var core))
+                {
+                    return pgcPcr[core];
+                }
+                if(offset == CpuPgcUpTrgOffset)
+                {
+                    // Core power-up completes immediately
+                    return 0;
+                }
+                return ToggleFlipFlop();
+            }
+        }
+
+        public void WriteDoubleWord(long offset, uint value)
+        {
+            lock(locker)
+            {
+                if(offset == LpcrA53AdOffset)
+                {
+                    lpcrA53Ad = value;
+                    return;
+                }
+                if(TryGetCorePgcPcr(offset, out var core))
+                {
+                    pgcPcr[core] = value;
+                    return;
+                }
+                if(offset == CpuPgcUpTrgOffset)
+                {
+                    return;
+                }
+                ToggleFlipFlop();
+            }
+        }
+
+        public long Size => 0x10000;
+
+        private static uint WfiPowerDownMask(int core) => 1u << (core < 2 ? core * 2 : (core - 2) * 2 + 16);
+
+        private static uint IrqWakeUpMask(int core) => core < 2 ? 1u << (core * 2 + 8) : 1u << (core * 2 + 20);
+
+        private static bool TryGetCorePgcPcr(long offset, out int core)
+        {
+            core = (int)((offset - CorePgcPcrOffset) / CorePgcStride);
+            return offset >= CorePgcPcrOffset && core < NumCores && offset == CorePgcPcrOffset + core * CorePgcStride;
+        }
+
+        private uint ToggleFlipFlop()
+        {
+            flipFlop = !flipFlop;
+            return flipFlop ? 0xFFFFFFFF : 0;
+        }
+
+        private bool IsArmedForPowerDown(int core)
+        {
+            return (lpcrA53Ad & WfiPowerDownMask(core)) != 0 && (pgcPcr[core] & PgcPcrPowerControlEnable) != 0;
+        }
+
+        private void OnWfiStateChange(int core, bool isInWfi)
+        {
+            if(!isInWfi)
+            {
+                return;
+            }
+            lock(locker)
+            {
+                if(poweredDown[core] || !IsArmedForPowerDown(core))
+                {
+                    return;
+                }
+                poweredDown[core] = true;
+                this.NoisyLog("Core{0} powered down on WFI", core);
+            }
+            // The wake request may already be asserted, it is only reported on GIC state changes
+            if(gic.IsWakeRequestAsserted((IARMSingleSecurityStateCPU)cpus[core]))
+            {
+                OnWakeRequest((IARMSingleSecurityStateCPU)cpus[core]);
+            }
+        }
+
+        private void OnWakeRequest(IARMSingleSecurityStateCPU cpu)
+        {
+            var core = System.Array.IndexOf(cpus, cpu as TranslationCPU);
+            if(core < 0)
+            {
+                return;
+            }
+            lock(locker)
+            {
+                if(!poweredDown[core])
+                {
+                    return;
+                }
+                if((lpcrA53Ad & IrqWakeUpMask(core)) == 0)
+                {
+                    this.NoisyLog("Wake request for core{0} ignored: IRQ wake-up disabled (LPCR_A53_AD 0x{1:X})", core, lpcrA53Ad);
+                    return;
+                }
+                poweredDown[core] = false;
+            }
+            // Power the core back up: it restarts from its SRC reset vector (still at EL3, where it was parked)
+            machine.LocalTimeSource.ExecuteInNearestSyncedState(_ =>
+            {
+                var entry = src.GetCoreEntry(core);
+                this.NoisyLog("Core{0} woken up, restarting at 0x{1:X}", core, entry);
+                cpus[core].PC = entry;
+                cpus[core].RequestWakeUpFromWfi();
+            });
+        }
+
+        private bool flipFlop;
+        private uint lpcrA53Ad;
+
+        private readonly uint[] pgcPcr;
+        private readonly bool[] poweredDown;
+        private readonly IMachine machine;
+        private readonly ARM_GenericInterruptController gic;
+        private readonly NXP_IMX8MP_SystemResetController src;
+        private readonly TranslationCPU[] cpus;
+        private readonly object locker = new object();
+
+        private const int NumCores = 4;
+        private const long LpcrA53AdOffset = 0x4;
+        private const long CpuPgcUpTrgOffset = 0xD0;
+        private const long CorePgcPcrOffset = 0x800;
+        private const long CorePgcStride = 0x40;
+        private const uint PgcPcrPowerControlEnable = 0x1;
+    }
+}
