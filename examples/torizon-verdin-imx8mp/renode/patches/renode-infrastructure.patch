+{
+    // i.MX 8M System Counter ("nxp,sysctr-timer"): the read frame (CNTCV) and compare frame 0
+    // (CMPCV0/CMPCR0), which Linux uses as the tick broadcast clockevent when the cores' local
+    // timers stop in deep cpuidle states. The control frame is not modeled.
+    public class NXP_IMX_SystemCounter : BasicDoubleWordPeripheral, IKnownSize
+    {
+        public NXP_IMX_SystemCounter(IMachine machine, ulong frequency = 8000000) : base(machine)
+        {
+            IRQ = new GPIO();
+            counter = new ComparingTimer(machine.ClockSource, frequency, this, "counter", enabled: true, workMode: WorkMode.Periodic);
+            counter.CompareReached += () =>
+            {
+                this.NoisyLog("Compare value 0x{0:X} reached", counter.Compare);
+                status = true;
+                UpdateInterrupt();
+            };
+            DefineRegisters();
+        }
+
+        public override void Reset()
+        {
+            base.Reset();
+            counter.Reset();
+            counter.Enabled = true;
+            status = false;
+            UpdateInterrupt();
+        }
+
+        public long Size => 0x20000;
+
+        public GPIO IRQ { get; }
+
+        private void DefineRegisters()
+        {
+            // Read frame
+            Registers.CounterLow.Define(this)
+                .WithValueField(0, 32, FieldMode.Read, name: "CNTCV_LO", valueProviderCallback: _ => (uint)counter.Value);
+            Registers.CounterHigh.Define(this)
+                .WithValueField(0, 24, FieldMode.Read, name: "CNTCV_HI", valueProviderCallback: _ => (uint)(counter.Value >> 32))
+                .WithReservedBits(24, 8);
+
+            // Compare frame 0
+            Registers.CompareLow.Define(this)
+                .WithValueField(0, 32, out compareLow, name: "CMPCV_LO", writeCallback: (_, __) => UpdateCompare());
+            Registers.CompareHigh.Define(this)
+                .WithValueField(0, 24, out compareHigh, name: "CMPCV_HI", writeCallback: (_, __) => UpdateCompare())
+                .WithReservedBits(24, 8);
+            Registers.CompareControl.Define(this)
+                .WithFlag(0, out enable, name: "EN", writeCallback: (_, val) =>
+                {
+                    // Clearing EN clears ISTAT (this is how Linux acknowledges the interrupt)
+                    if(!val)
+                    {
+                        status = false;
+                    }
+                    UpdateCompare();
+                })
+                .WithFlag(1, out interruptMask, name: "IMASK", writeCallback: (_, __) => UpdateInterrupt())
+                .WithFlag(2, FieldMode.Read, name: "ISTAT", valueProviderCallback: _ => status)
+                .WithReservedBits(3, 29);
+        }
+
+        private void UpdateCompare()
+        {
+            var compare = (compareHigh.Value << 32) | compareLow.Value;
+            counter.EventEnabled = enable.Value;
+            counter.Compare = compare;
+            this.NoisyLog("Compare set to 0x{0:X} (counter 0x{1:X}, enabled {2})", compare, counter.Value, enable.Value);
+            // ISTAT is set whenever the counter is at or past the compare value
+            if(enable.Value && counter.Value >= compare)
+            {
+                status = true;
+            }
+            UpdateInterrupt();
+        }
+
+        private void UpdateInterrupt()
+        {
+            var irq = enable.Value && status && !interruptMask.Value;
+            if(irq != IRQ.IsSet)
+            {
+                this.NoisyLog("IRQ {0}", irq ? "set" : "cleared");
+            }
+            IRQ.Set(irq);
+        }
+
+        private bool status;
+        private IValueRegisterField compareLow;
+        private IValueRegisterField compareHigh;
+        private IFlagRegisterField enable;
+        private IFlagRegisterField interruptMask;
+
+        private readonly ComparingTimer counter;
+
+        private enum Registers
+        {
+            CounterLow = 0x8,
+            CounterHigh = 0xC,
+            CompareLow = 0x10020,
+            CompareHigh = 0x10024,
+            CompareControl = 0x1002C,
+        }
+    }
+}
