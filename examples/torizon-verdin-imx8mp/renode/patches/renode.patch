diff --git a/platforms/boards/toradex-verdin-imx8mp-4gb.repl b/platforms/boards/toradex-verdin-imx8mp-4gb.repl
new file mode 100644
index 0000000..5696254
--- /dev/null
+++ b/platforms/boards/toradex-verdin-imx8mp-4gb.repl
@@ -0,0 +1,6 @@
+// Toradex Verdin iMX8M Plus Quad 4GB IT (product 0063, no Wi-Fi/BT)
+using "platforms/boards/toradex-verdin-imx8mp.repl"
+
+// 4 GiB LPDDR4: 3 GiB at 0x40000000 + 1 GiB above the 4 GiB boundary
+memory_ddr:
+    size: 0xc0000000
diff --git a/platforms/boards/toradex-verdin-imx8mp.repl b/platforms/boards/toradex-verdin-imx8mp.repl
new file mode 100644
index 0000000..c652f8a
--- /dev/null
+++ b/platforms/boards/toradex-verdin-imx8mp.repl
@@ -0,0 +1,80 @@
+// Toradex Verdin iMX8M Plus Quad 2GB (product 0061, no Wi-Fi/BT) system on module
+// For the 4 GiB SKU use toradex-verdin-imx8mp-4gb.repl (needs ~5+ GiB of host RAM).
+using "platforms/cpus/nxp-mimx8ml.repl"
+
+// 2 GiB LPDDR4 at 0x40000000. U-Boot sizes DRAM with get_ram_size() and passes it to Linux.
+memory_ddr:
+    size: 0x80000000
+
+memory_ddr_cortexA_cluster:
+    size: 0x40000000
+
+// Instructions per virtual second. Renode's default (100 MIPS) makes Torizon need ~65 s of virtual time
+// before systemd takes over the watchdog, so U-Boot's 60 s watchdog resets the board. Higher values make
+// every busy-wait (U-Boot's autoboot countdown, udelay) proportionally more expensive to emulate, since
+// counter polling runs ~13x slower than regular code. 400 MIPS reaches the takeover in ~18 s.
+cpu0:
+    PerformanceInMips: 400
+
+cpu1:
+    PerformanceInMips: 400
+
+cpu2:
+    PerformanceInMips: 400
+
+cpu3:
+    PerformanceInMips: 400
+
+// SDMA instead of PIO: Linux sdhci-esdhc-imx busy-waits 100 us per block in PIO mode
+usdhc2:
+    dmaSupported: true
+
+usdhc3:
+    dmaSupported: true
+
+gpt1:
+    frequency: 24000000
+
+gpt2:
+    frequency: 24000000
+
+gpt3:
+    frequency: 24000000
+
+gpt4:
+    frequency: 24000000
+
+gpt5:
+    frequency: 24000000
+
+gpt6:
+    frequency: 24000000
+
+// Gigabit Ethernet PHY (KSZ9131) on the EQOS MAC
+phy_qos: Network.EthernetPhysicalLayer @ eth_qos 7
+    Id1: 0x0022
+    Id2: 0x1642
+    AutoNegotiationAdvertisement: 0x1e1
+    AutoNegotiationLinkPartnerBasePageAbility: 0x1e1
+    MasterSlaveControl: 0x300
+    MasterSlaveStatus: 0x3000
+
+// Second Ethernet PHY on the FEC MAC (Verdin Development Board)
+phy_mac: Network.EthernetPhysicalLayer @ eth_mac 7
+    Id1: 0x0022
+    Id2: 0x1622
+    AutoNegotiationAdvertisement: 0x1e1
+    AutoNegotiationLinkPartnerBasePageAbility: 0x1e1
+    MasterSlaveControl: 0x300
+    MasterSlaveStatus: 0x3000
+
+// On-module I2C (i2c1)
+pmic: Mocks.DummyI2CSlave @ i2c1 0x25 // pca9450c
+rtc: Mocks.DummyI2CSlave @ i2c1 0x32 // rx8130
+temp_sensor: Mocks.DummyI2CSlave @ i2c1 0x48 // tmp1075
+adc: Mocks.DummyI2CSlave @ i2c1 0x49 // ads1015
+module_eeprom: Mocks.DummyI2CSlave @ i2c1 0x50 // 24c02
+
+sysbus:
+    init add:
+        Tag <0x30350440 0x4> "OCOTP_TESTER3" 0x00000500 // 1800 MHz Speed grade
diff --git a/scripts/single-node/toradex-verdin-imx8mp_torizon.resc b/scripts/single-node/toradex-verdin-imx8mp_torizon.resc
new file mode 100644
index 0000000..37df455
--- /dev/null
+++ b/scripts/single-node/toradex-verdin-imx8mp_torizon.resc
@@ -0,0 +1,55 @@
+:name: Toradex Verdin iMX8M Plus - Torizon OS
+:description: Boots an official Torizon OS image (TF-A + U-Boot from imx-boot, eMMC from the Tezi rootfs)
+
+# Artifacts produced by torizon/prepare-image.sh from the official Tezi image
+$torizon_dir?=@../torizon/out/verdin-imx8mp
+$uboot_bin?=$torizon_dir/u-boot.bin
+$bl31_bin?=$torizon_dir/bl31.bin
+$emmc_img?=$torizon_dir/emmc.img
+$emmc_boot0_img?=$torizon_dir/emmc-boot0.img
+$emmc_size?=0x80000000     # must match EMMC_SIZE_MB used by prepare-image.sh (default 2048)
+$emmc_persistent?=False
+
+$name?="verdin-imx8mp"
+$platform?=@platforms/boards/toradex-verdin-imx8mp.repl   # or toradex-verdin-imx8mp-4gb.repl (rebuild with PRODUCT_ID=63)
+using sysbus
+mach create $name
+
+machine LoadPlatformDescription $platform
+
+using sysbus.ca53Cluster
+
+# Spoof the i.MX8MP Boot ROM API (see nxp-imx8mplus_linux.resc): g_rom_api at 0x980,
+# query_boot_infor (+0x10) points to a stub reporting BT_DEV_TYPE_MMC, instance 2 (uSDHC3 eMMC),
+# so U-Boot picks mmc 2 for its environment, like after a real eMMC boot.
+sysbus WriteQuadWord 0x990 0x1000 cpu0
+cpu0 AssembleBlock 0x1000 """
+  movz w2, #2, lsl #16;
+  movk w2, #2;
+  str  w2, [x1];
+  movz w0, #0xf0;
+  ret
+""" triple="arm64"
+
+showAnalyzer uart3
+
+machine SdCardFromFile $emmc_img usdhc3 size=$emmc_size persistent=$emmc_persistent name="emmc" emmc=true bootPartition0Image=$emmc_boot0_img
+
+macro reset
+"""
+    # What SPL leaves behind: U-Boot proper (+ control DTB) and BL31 in memory, entering BL31 at EL3
+    sysbus LoadBinary $uboot_bin 0x40200000
+    sysbus LoadBinary $bl31_bin 0x970000
+
+    ca53Cluster ForEach IsHalted true
+    cpu0 PC 0x970000
+    # cpu0 is unhalted to start TF-A -> U-Boot; remaining cores are released by PSCI
+    cpu0 IsHalted false
+
+    # Disable the power-on Watchdog Timer. On hardware this is handled by the bootrom
+    wdog1 WriteWord 0x8 0x0
+    wdog2 WriteWord 0x8 0x0
+    wdog3 WriteWord 0x8 0x0
+"""
+
+runMacro $reset
